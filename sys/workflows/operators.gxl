// 系统运维流程（**本地定义**，不引外部 ops-gxl 模块）。
//
// 由 _gal/work.gxl 的 `mod main : operators` 纳入，gops 以 `gx run <flow>` 调用。
// 约定：GXL 行注释是 //（# 是注解语法 #[...]，不是注释）。
mod operators {

  // 阶段扩展点：`gops sys localize` 写完系统根 .env 之后就执行 `gx run localize`
  // （galaxy-ops >= 1.3.4 / galaxy-flow >= 0.14）。合并后的配置以**环境变量**注入本子进程，
  // 用 $(printenv XXX) 读。每个动作都**幂等**（存在即跳过）——证书/密钥绝不能每次重生成。
  flow localize {
    // 0) 确保运行期/身份目录存在（渲染目标落 configs/，站点身份落 identity/；Docker 会在 up 时
    //    自建缺失的挂载源，但那时属主是 root，所以我们先建、随后由 `gops sys perms` 归位）。
    //    拆挂后 configs/center **本身不再是挂载源**，但它仍必须由 localize 以部署账号创建。
    gx.cmd ( "mkdir -p configs/center configs/web configs/station configs/git-proxy identity/center artifacts" );
    // ① 备料控制中心：CA（信任根 + 服务器证书，落站点身份 identity/center）+ 渲染值
    //    wist-center.value.json + 凭据密钥文件 `.wist/sec-value.yml`（缺什么补什么）。
    //    CA 已存在即跳过（换公章会让所有已分发信任根失效）。域名取合并后的值 CENTER_DOMAIN。
    gx.cmd ( "./scripts/init-center.sh configs/center $(printenv CENTER_DOMAIN)" );
    // ①' 现场态（站点事实）：**声明 + 值分开**（docker-compose 口径）。
    //     · **声明** `wist-center-pub.toml`（只写 `${VAR}` 引用、不含现场值）—— 与其它交付物一样
    //       走 **tpl** 机制渲染（交付物，随版本覆盖；值不在这里，所以重渲动不到现场）；
    //     · **值** 在同目录 `.env`（脚本按缺补齐，永不重渲）。
    //     主配置里**不写** public_url，否则与声明撞键拒启。
    gx.tpl (
      tpl  : "./sys/configs/center/wist-center-pub.toml.tpl",
      dst  : "./identity/center/wist-center-pub.toml",
      data : "{}"
    );
    gx.cmd ( "./scripts/init-center-pub.sh identity/center" );
    // ② 渲染中心运行配置：模板 + value.json → configs/center/wist-center.toml（依赖 ①）。
    //    模板里的 admin_token / hmac_secret 写的是 `${SEC_CENTER_*}`，由中心加载时从密钥文件
    //    （WIST_CENTER_SEC_FILE 指向的 .wist/sec-value.yml）解析 —— 明文不落盘。
    gx.tpl (
      tpl  : "./sys/configs/center/wist-center.toml.tpl",
      dst  : "./configs/center/wist-center.toml",
      file : "./configs/center/wist-center.value.json"
    );
    // ②' 规则管理（WarpStation）：备料运行期目录 / 密钥 / 渲染值 / CNB 预克隆 / WarpParse CA。
    //     · 与中心**解耦**：中心不可用不影响规则维护；但 WarpStation 预加载的 CA 默认取中心 CA，
    //       所以必须在 ①/② 之后执行（identity/center/control-center.pem 已就绪）。
    //     · gitea/wparse__models、gitea/wparse__infra 是外部 CNB 仓库的工作副本（git-only），落在
    //       configs/station 下：随 configs/ 一起备份，且不会进交付包（sys-prj.yml 的 ignore/protect）。
    //     · Git 凭据由环境注入（WP_GIT_PUSH_TOKEN / WP_GIT_PUB_TOKEN），或写 .wist，不写 vars。
    gx.cmd ( "./scripts/init-station.sh configs/station" );
    //     · 渲染 WarpStation 主配置（DB 密码渲染进 config.toml；CNB 写 token 走 station.env）。
    gx.tpl (
      tpl  : "./sys/configs/station/config.toml.tpl",
      dst  : "./configs/station/config.toml",
      file : "./configs/station/station.value.json"
    );
    //     · 渲染 Git Proxy（路径白名单 + CNB 读凭据；值来自 git-proxy.value.json）。
    gx.tpl (
      tpl  : "./sys/configs/git-proxy/nginx.conf.tpl",
      dst  : "./configs/git-proxy/nginx.conf",
      file : "./configs/git-proxy/git-proxy.value.json"
    );
    //     · 收紧配置/密钥文件权限（含 CNB 读凭据的 nginx.conf 必须 600）；
    //       随后 `gops sys perms` 会按 compose 的只读挂载再对齐一次。
    gx.cmd ( "chmod 640 configs/station/config.toml && chmod 600 configs/station/station.env configs/station/station.value.json configs/git-proxy/git-proxy.value.json configs/git-proxy/nginx.conf" );

    // ③ 前端站点配置：备料渲染值（脚本）→ gx.tpl → configs/web/nginx.conf。
    //    渲染值必须走脚本，不能在这里 printf：GXL 字符串**不还原 `\"`**，而 Ubuntu 的 /bin/sh 是
    //    dash（printf 不认 `\"`，会把反斜杠写进文件）→ 非法 JSON → gx.tpl 报 parse json data file。
    //    macOS 上 sh 是 bash（printf 吃掉反斜杠）所以看不出问题。详见脚本头部注释。
    gx.cmd ( "./scripts/init-web-conf.sh $(printenv CENTER_DOMAIN) $(printenv STATION_DOMAIN)" );
    gx.tpl (
      tpl  : "./sys/configs/web/nginx.conf.tpl",
      dst  : "./configs/web/nginx.conf",
      file : "./configs/web/nginx.value.json"
    );
    // ④ 宿主侧属主/权限对齐（Linux 专有；macOS/OrbStack 直接跳过）：
    //    center **固定以 999:999 运行**（compose 里显式钉死），而 Linux 的 bind 挂载**不改属主**
    //    —— 未对齐就是稳定故障：容器写不出 state/ 与 artifacts/、读不到 identity/ 里的私钥与
    //    `.wist/sec-value.yml`（`${SEC_CENTER_*}` 解析失败）。
    //    用 `gops sys perms --apply`（gops ≥ 2.7，本栈硬要求）：它从 `docker compose config`
    //    派生「哪些挂载要写、哪些只读」，不需要本仓维护名单 —— 增减挂载只需改 compose。
    //    必须放在 localize **最后**：上面的备料会新建文件（umask 可能使其对容器不可读）。
    //    还必须在 `docker compose up` **之前**：Docker 会把缺失的挂载源目录建成 root:root，
    //    属主一旦是 root，之后的部署账号就写不动了。
    //    幂等：已对齐时不写盘、也不要任何权限；`gops sys perms --check` 可单独做只读自检。
    gx.cmd ( "gops sys perms --help >/dev/null 2>&1 || { echo '错误：本栈需要 gops >= 2.7（gops sys perms）'; exit 1; }; gops sys perms --apply" );
  }

}
