# 运行时状态 / 本地数据（开发态的本地 JSON store / 制品镜像 / pid）
.run/

# 中心制品镜像（版本发布下载/镜像下来的安装包）——本地数据，不入库；备走 `gops prj backup`
/artifacts/

# WarpStation 工作区（wp-rules / wp-infra 的 git clone）——现场数据，不入库；
# 由 `STATION_KNOWLEDGE_DIR` 指定（默认 ./knowledge/station）。
/knowledge/

# 中心**运行期**配置与密钥（现场生成；含 admin token / hmac secret / JSON store）。
# 声明模板在 sys/configs/ 随库入库。
/configs/
# 同类目录的任何副本（`configs_x/` 等：同样是运行物，含私钥，绝不入库）
/configs*/

# 站点身份（dev/prod **共用**）：CA / 服务器证书 / 私钥（`identity/center/control-center*`）
# —— 现场生成、含私钥，绝不入库；契约与备份由 sys-prj.yml 的 `contract: - identity` 声明。
/identity/
# 同类目录的任何副本（`identity_x/` 等：同样含私钥）
/identity*/

# ===== gops 生成物 =====
# 变量解析结果（gops sys update / package 生成）
sys/resolved_vars.yml
# 交付锁（`gops sys package` 生成，带时间戳；不入库，由 package 自己塞进交付包）
/deliver.lock
# 值文件：现场值由 ops-prj 项目维护（<prj>/values/<sys>/），本仓不再跟踪 values/ 内容。
values/
# .env 由 gops sys localize 生成（非密钥配置）
.env

# 密钥文件目录（栈根 `.wist/sec-value.yml`：admin token / hmac secret，中心用 ${SEC_*} 从它解析）
/.wist/
# orion-sec 默认密钥目录（`.galaxy/sec_value.yml` / `~/.galaxy/sec_value.yml`）
/.galaxy/

# 中心身份备份产物（含私钥，别入库）
wist-center-backup-*.tar.gz

# 开发态中心 home（`dev/svc.sh` 生成：含 admin token / TLS 私钥 / CA / 本地 JSON store）
# —— 与发布态同性质，绝不入库（上面的 `/configs/` 是根路径锚定写法，盖不到 `dev/configs/`）。
/dev/configs/

# macOS
.DS_Store
.report
.run*
# 迁移（gops >= 1.4）：模块按目标模型分组（本栈纯 compose，保留以对齐 gateway-stack）
sys/*/mods
